rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function queuePath(queueId) {
      return /databases/$(database)/documents/queues/$(queueId);
    }

    function isQueueOwner(queueId) {
      return get(queuePath(queueId)).data.ownerId == request.auth.uid;
    }

    function isQueueOperator(queueId) {
      return exists(/databases/$(database)/documents/queues/$(queueId)/operators/$(request.auth.uid));
    }

    function validInvite(queueId, code) {
      let invite = get(/databases/$(database)/documents/operatorInvites/$(code));
      return invite.data.queueId == queueId
        && (invite.data.expiresAt == null || invite.data.expiresAt > request.time);
    }

    function notAnonymous() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function validGroupId(data) {
      return !('groupId' in data)
        || (data.groupId is string && data.groupId.size() > 0 && data.groupId.size() <= 40);
    }

    function validNullableInt(m, key, lo, hi) {
      let v = m.get(key, null);
      return v == null || (v is int && v >= lo && v <= hi);
    }

    function validAlerts(a) {
      return a == null
        || (a is map
          && a.keys().hasOnly(['enabled', 'maxWaitMin', 'maxNoShowPct', 'idleMin', 'cooldownMin'])
          && a.enabled is bool
          && validNullableInt(a, 'maxWaitMin', 1, 240)
          && validNullableInt(a, 'maxNoShowPct', 1, 100)
          && validNullableInt(a, 'idleMin', 5, 240)
          && validNullableInt(a, 'cooldownMin', 5, 1440));
    }

    function alertsOkOnCreate() {
      return validAlerts(request.resource.data.get('alerts', null))
        && !('alertState' in request.resource.data);
    }

    function validSlot(s) {
      let c = s.capacity;
      return s.start.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && c is int && c >= 1 && c <= 50;
    }

    function validSlots(slots) {
      let n = slots.size();
      let p = slots.concat(slots);
      let q = p.concat(p);
      let r = q.concat(q);
      let t = r.concat(r);
      let e = t.concat(t);
      return slots is list
        && n <= 20
        && (n == 0
          || (validSlot(e[0]) && validSlot(e[1]) && validSlot(e[2]) && validSlot(e[3])
            && validSlot(e[4]) && validSlot(e[5]) && validSlot(e[6]) && validSlot(e[7])
            && validSlot(e[8]) && validSlot(e[9]) && validSlot(e[10]) && validSlot(e[11])
            && validSlot(e[12]) && validSlot(e[13]) && validSlot(e[14]) && validSlot(e[15])
            && validSlot(e[16]) && validSlot(e[17]) && validSlot(e[18]) && validSlot(e[19])));
    }

    function scheduleModeOk(data) {
      return (!('mode' in data) || data.mode in ['queue', 'schedule'])
        && (!('slots' in data) || validSlots(data.slots));
    }

    function validQueueName(v) {
      return v is string && v.size() >= 1 && v.size() <= 60;
    }

    function validQueueDescription(v) {
      return v == null || (v is string && v.size() <= 300);
    }

    function validAvgServiceMin(v) {
      return v is int && v >= 1 && v <= 240;
    }

    function queueInfoOkOnCreate(data) {
      return (!('name' in data) || validQueueName(data.name))
        && validQueueDescription(data.get('description', null))
        && (!('avgServiceMin' in data) || validAvgServiceMin(data.avgServiceMin));
    }

    function queueInfoFieldsOk(d, changed) {
      return (!('name' in changed) || validQueueName(d.get('name', null)))
        && (!('description' in changed) || validQueueDescription(d.get('description', null)))
        && (!('avgServiceMin' in changed) || validAvgServiceMin(d.get('avgServiceMin', null)));
    }

    function queueUpdateFieldsOk() {
      let d = request.resource.data;
      let changed = d.diff(resource.data).affectedKeys();
      return (!changed.hasAny(['name', 'description', 'avgServiceMin'])
          || queueInfoFieldsOk(d, changed))
        && (!changed.hasAny(['retentionDays', 'anonymizePhone'])
          || privacyFieldsOk(d, changed))
        && !changed.hasAny(['alertState', 'deleting', 'ownerId'])
        && (!('mode' in changed) || d.get('mode', null) in ['queue', 'schedule'])
        && (!('slots' in changed) || validSlots(d.get('slots', null)))
        && (!('alerts' in changed) || validAlerts(d.get('alerts', null)))
        && (!('expiry' in changed) || d.get('expiry', null) is map);
    }

    function validRetentionDays(v) {
      return v is int && v >= 30 && v <= 730;
    }

    function privacyFieldsOk(d, changed) {
      return (!('retentionDays' in changed) || validRetentionDays(d.get('retentionDays', null)))
        && (!('anonymizePhone' in changed) || d.get('anonymizePhone', null) is bool);
    }

    function privacyOkOnCreate(data) {
      return (!('retentionDays' in data) || validRetentionDays(data.retentionDays))
        && (!('anonymizePhone' in data) || data.anonymizePhone is bool);
    }

    match /owners/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /devices/{deviceId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['token', 'platform', 'lang', 'updatedAt'])
          && request.resource.data.keys().hasAll(['token'])
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0
          && request.resource.data.token.size() <= 4096;
      }

      match /groups/{groupId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['name', 'createdAt'])
          && request.resource.data.keys().hasAll(['name'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 40;
      }
    }

    match /operatorInvites/{code} {
      allow get: if notAnonymous();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && isQueueOwner(request.resource.data.queueId);
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && isQueueOwner(request.resource.data.queueId);
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /queues/{queueId} {
      allow get: if signedIn()
        && (resource.data.ownerId == request.auth.uid || isQueueOperator(queueId));
      allow list: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && validGroupId(request.resource.data)
        && alertsOkOnCreate()
        && !('deleting' in request.resource.data)
        && queueInfoOkOnCreate(request.resource.data)
        && privacyOkOnCreate(request.resource.data)
        && (!('expiry' in request.resource.data) || request.resource.data.expiry is map)
        && scheduleModeOk(request.resource.data);
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && validGroupId(request.resource.data)
        && queueUpdateFieldsOk();
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;

      match /history/{entryId} {
        allow read, write: if signedIn() && isQueueOwner(queueId);
        allow create: if signedIn()
          && isQueueOperator(queueId)
          && request.resource.data.operatorId == request.auth.uid
          && request.resource.data.result in ['served', 'no_show']
          && request.resource.data.keys().hasOnly(['ticket', 'name', 'phone', 'result', 'joinedAt', 'calledAt', 'calledBy', 'operatorId', 'finishedAt', 'recalls', 'skips'])
          && request.resource.data.keys().hasAll(['ticket', 'name', 'phone', 'result', 'joinedAt', 'calledAt', 'calledBy', 'operatorId', 'finishedAt']);
      }

      match /feedback/{entryId} {
        allow read, delete: if signedIn() && isQueueOwner(queueId);
      }

      match /operators/{opUid} {
        allow get: if signedIn() && (request.auth.uid == opUid || isQueueOwner(queueId));
        allow list, write: if signedIn() && isQueueOwner(queueId);
      }

      match /operatorRequests/{reqUid} {
        allow get: if signedIn() && (request.auth.uid == reqUid || isQueueOwner(queueId));
        allow list: if signedIn() && isQueueOwner(queueId);
        allow create: if notAnonymous()
          && request.auth.uid == reqUid
          && request.resource.data.uid == reqUid
          && request.resource.data.status == 'pending'
          && validInvite(queueId, request.resource.data.code);
        allow update: if signedIn() && (
          (isQueueOwner(queueId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
            && request.resource.data.status in ['approved', 'rejected', 'removed'])
          || (notAnonymous()
            && request.auth.uid == reqUid
            && resource.data.status != 'pending'
            && request.resource.data.uid == reqUid
            && request.resource.data.status == 'pending'
            && validInvite(queueId, request.resource.data.code))
        );
        allow delete: if signedIn() && (request.auth.uid == reqUid || isQueueOwner(queueId));
      }
    }

    match /{path=**}/operators/{opUid} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /{path=**}/operatorRequests/{reqUid} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
