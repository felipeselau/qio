# Firebase Cloud Messaging — Web Push certificates (VAPID public key)
# https://console.firebase.google.com/project/qio-app/settings/cloudmessaging
VITE_VAPID_KEY=

# Firebase App Check — chave reCAPTCHA Enterprise (Fraud Defense, tipo Web).
# Protege as callables joinQueue e submitFeedback contra chamadas automatizadas fora do site.
# RTDB/Firestore NÃO têm enforcement (o app Flutter não usa App Check).
# 1. https://console.cloud.google.com/security/recaptcha — criar chave Web no projeto qio-app
#    (qio.web.app, qio-app.web.app, qio-app.firebaseapp.com; sem localhost)
# 2. https://console.firebase.google.com/project/qio-app/appcheck — registrar o app Web com reCAPTCHA Enterprise
# 3. Enforcement é ligado só nas functions (ENFORCE_APP_CHECK em functions/.env). Ver docs/APPCHECK.md.
VITE_RECAPTCHA_SITE_KEY=

# Usa os emulators locais (firebase emulators:start). Só para testes.
VITE_USE_EMULATORS=

# Firebase Analytics (GA4) — ID de métrica do app Web (G-XXXXXXXXXX), em
# https://console.firebase.google.com/project/qio-app/settings/general
# Só é usado em build de produção; sem o ID não há coleta. Opt-out do visitante:
# localStorage 'qio:analytics-optout' = '1' (ou Do Not Track ligado).
VITE_MEASUREMENT_ID=
