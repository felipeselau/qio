# Firebase Cloud Messaging — Web Push certificates (VAPID public key)
# https://console.firebase.google.com/project/qio-app/settings/cloudmessaging
VITE_VAPID_KEY=

# Firebase App Check — chave reCAPTCHA Enterprise (Fraud Defense, tipo Web) (protege RTDB/Firestore
# contra entradas falsas/automatizadas na fila, ex.: scripts batendo direto
# na API do Firebase fora do site).
# 1. https://console.cloud.google.com/security/recaptcha — criar chave Web (sem localhost)
# 2. https://console.firebase.google.com/project/qio-app/appcheck — registrar o app Web com reCAPTCHA Enterprise
# 3. Depois de testar (App Check > Apps > ver métricas), ativar "Enforce"
#    para Realtime Database em App Check > APIs
VITE_RECAPTCHA_SITE_KEY=

# Usa os emulators locais (firebase emulators:start). Só para testes.
VITE_USE_EMULATORS=
