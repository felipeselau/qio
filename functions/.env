# App Check nas callables joinQueue/submitFeedback. Só true após rollout (docs/APPCHECK.md).
# ENFORCE_APP_CHECK_JOIN / ENFORCE_APP_CHECK_FEEDBACK (opcionais) sobrescrevem por callable.
ENFORCE_APP_CHECK=false
JOIN_RATE_LIMIT_MAX=3
JOIN_RATE_LIMIT_WINDOW_MIN=10
# deleteQueue/deleteAccount (chamadas só pelo app Flutter, sem App Check): não herdam ENFORCE_APP_CHECK.
ENFORCE_APP_CHECK_DELETE=false
# findCustomerData/exportCustomerData/eraseCustomerData (só o app Flutter, sem App Check): não herdam ENFORCE_APP_CHECK.
ENFORCE_APP_CHECK_DSR=false
# DSR_HASH_PEPPER (opcional, segredo): tempera o hash do telefone em owners/{uid}/dataRequests. É pseudonimização, não anonimização: telefone tem poucas combinações e o hash pode ser revertido por força bruta sem pepper.
