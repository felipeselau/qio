# App Check nas callables joinQueue/submitFeedback. Só true após rollout (docs/APPCHECK.md).
# ENFORCE_APP_CHECK_JOIN / ENFORCE_APP_CHECK_FEEDBACK (opcionais) sobrescrevem por callable.
ENFORCE_APP_CHECK=false
JOIN_RATE_LIMIT_MAX=3
JOIN_RATE_LIMIT_WINDOW_MIN=10
# deleteQueue/deleteAccount (chamadas só pelo app Flutter, sem App Check): não herdam ENFORCE_APP_CHECK.
ENFORCE_APP_CHECK_DELETE=false
