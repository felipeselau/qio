{
  "rules": {
    "queues": {
      "$queueId": {
        "meta": {
          ".read": "auth != null",
          ".write": "root.child('owners').child($queueId).child('ownerUid').val() === auth.uid"
        },
        "entries": {
          ".read": "auth != null",
          "$entryId": {
            ".read": "auth != null",
            ".write": "(!data.exists() && newData.child('uid').val() === auth.uid) || (data.child('uid').val() === auth.uid) || (root.child('owners').child($queueId).child('ownerUid').val() === auth.uid)"
          }
        }
      }
    },
    "owners": {
      "$queueId": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('ownerUid').val() === auth.uid) || (data.child('ownerUid').val() === auth.uid && (!newData.exists() || newData.child('ownerUid').val() === auth.uid)))"
      }
    },
    "tickets": {
      "$queueId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}