{
  "rules": {
    "queues": {
      "$queueId": {
        "meta": {
          ".read": "auth != null",
          ".write": "root.child('owners').child($queueId).child('ownerUid').val() === auth.uid",
          "serving": {
            ".write": "root.child('queues').child($queueId).child('operatorUids').child(auth.uid).val() === true"
          },
          "updatedAt": {
            ".write": "root.child('queues').child($queueId).child('operatorUids').child(auth.uid).val() === true"
          },
          "maxWaiting": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000 && newData.val() % 1 === 0"
          },
          "statusMessage": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "resumeAt": {
            ".validate": "newData.isNumber()"
          },
          "opensAt": {
            ".validate": "newData.isNumber()"
          },
          "brandColor": {
            ".validate": "newData.isString() && newData.val().matches(/^#[0-9A-Fa-f]{6}$/)"
          },
          "mode": {
            ".validate": "newData.isString() && (newData.val() === 'queue' || newData.val() === 'schedule')"
          },
          "slots": {
            "$slotId": {
              ".validate": "$slotId.matches(/^[A-Za-z0-9_-]{1,20}$/) && newData.hasChildren(['start', 'capacity'])",
              "start": {
                ".validate": "newData.isString() && newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/)"
              },
              "capacity": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 50 && newData.val() % 1 === 0"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "logoUrl": {
            ".validate": "newData.isString() && newData.val().length <= 600 && newData.val().matches(/^https:\\/\\/firebasestorage\\.googleapis\\.com\\//)"
          }
        },
        "entries": {
          ".read": "(root.child('owners').child($queueId).child('ownerUid').val() === auth.uid) || (root.child('queues').child($queueId).child('operatorUids').child(auth.uid).val() === true)",
          ".indexOn": [
            "status",
            "ticket",
            "uid",
            "phone"
          ],
          "$entryId": {
            ".read": "(root.child('owners').child($queueId).child('ownerUid').val() === auth.uid) || (root.child('queues').child($queueId).child('operatorUids').child(auth.uid).val() === true) || data.child('uid').val() === auth.uid",
            ".write": "(data.child('uid').val() === auth.uid && (!newData.exists() || (newData.child('ticket').val() === data.child('ticket').val() && newData.child('name').val() === data.child('name').val() && newData.child('phone').val() === data.child('phone').val() && newData.child('joinedAt').val() === data.child('joinedAt').val() && newData.child('calledAt').val() === data.child('calledAt').val() && newData.child('operatorId').val() === data.child('operatorId').val() && newData.child('order').val() === data.child('order').val() && newData.child('recalls').val() === data.child('recalls').val() && newData.child('skips').val() === data.child('skips').val() && newData.child('recalledAt').val() === data.child('recalledAt').val() && newData.child('lang').val() === data.child('lang').val() && newData.child('nextNotifiedAt').val() === data.child('nextNotifiedAt').val() && newData.child('slotId').val() === data.child('slotId').val() && newData.child('slotStart').val() === data.child('slotStart').val() && newData.child('uid').val() === data.child('uid').val() && (newData.child('status').val() === data.child('status').val() || newData.child('status').val() === 'left')))) || (root.child('owners').child($queueId).child('ownerUid').val() === auth.uid) || (root.child('queues').child($queueId).child('operatorUids').child(auth.uid).val() === true)",
            ".validate": "newData.hasChildren(['ticket', 'status', 'uid']) && (data.exists() || newData.child('name').exists())",
            "ticket": {
              ".validate": "newData.isNumber()"
            },
            "status": {
              ".validate": "newData.isString() && (newData.val() === 'waiting' || newData.val() === 'called' || newData.val() === 'served' || newData.val() === 'no_show' || newData.val() === 'left')"
            },
            "uid": {
              ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())"
            },
            "name": {
              ".validate": "(data.exists() && newData.val() === data.val()) || (newData.isString() && newData.val().length >= 1 && newData.val().length <= 60)"
            },
            "phone": {
              ".validate": "(data.exists() && newData.val() === data.val()) || (newData.isString() && (newData.val() === '' || newData.val().matches(/^\\(\\d{2}\\) \\d{4,5}-\\d{4}$/)))"
            },
            "fcmToken": {
              ".validate": "newData.isString()"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "calledAt": {
              ".validate": "newData.isNumber()"
            },
            "operatorId": {
              ".validate": "newData.isString()"
            },
            "order": {
              ".validate": "newData.isNumber()"
            },
            "recalledAt": {
              ".validate": "newData.isNumber()"
            },
            "recalls": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 === 0"
            },
            "skips": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 === 0"
            },
            "lang": {
              ".validate": "newData.isString() && (newData.val() === 'pt' || newData.val() === 'en' || newData.val() === 'es')"
            },
            "nextNotifiedAt": {
              ".validate": "newData.isNumber()"
            },
            "slotId": {
              ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,20}$/)"
            },
            "slotStart": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "public": {
          ".read": "auth != null",
          ".write": "!newData.exists() && root.child('owners').child($queueId).child('ownerUid').val() === auth.uid"
        },
        "operatorUids": {
          ".read": "root.child('owners').child($queueId).child('ownerUid').val() === auth.uid",
          ".write": "root.child('owners').child($queueId).child('ownerUid').val() === auth.uid",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".validate": "newData.isBoolean()"
          }
        }
      }
    },
    "owners": {
      "$queueId": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('ownerUid').val() === auth.uid) || (data.child('ownerUid').val() === auth.uid && (!newData.exists() || newData.child('ownerUid').val() === auth.uid)))"
      }
    },
    "tickets": {
      "$queueId": {
        ".read": false,
        ".write": "root.child('owners').child($queueId).child('ownerUid').val() === auth.uid"
      }
    },
    "rateLimits": {
      ".read": false,
      ".write": false
    }
  }
}
